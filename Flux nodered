{
"id": "c0de0000000000f1",
"type": "function",
"name": "ALARME",
"func": "// ============================================================\n// FONCTION ALARME\n// Entrees : ghjxwyz/esp32/max30102/bpm, ghjxwyz/esp32/max30102/spo2, ghjxwyz/esp32/button1\n// Sortie 1 : ordre LED (\"on\"/\"off\") -> ghjxwyz/esp32/output (ESP32 Pilotage)\n// Sortie 2 : texte alarme pour le dashboard\n// Sortie 3 : etat du bouton toggle pour le dashboard\n// ============================================================\n\n// 1) On memorise la derniere valeur recue de chaque topic\nif (msg.topic === \"ghjxwyz/esp32/button1\") {\n let etat = String(msg.payload); // \"down\" = appuye, \"up\" = relache\n let avant = flow.get(\"dernierEtatBouton\") || \"up\";\n flow.set(\"dernierEtatBouton\", etat);\n if (etat === \"down\" && avant === \"up\") { // a chaque nouvel appui...\n flow.set(\"surveillance\", !(flow.get(\"surveillance\") || false)); // ...on inverse ON/OFF\n }\n}\nif (msg.topic === \"ghjxwyz/esp32/max30102/bpm\") { flow.set(\"bpm\", Number(msg.payload)); }\nif (msg.topic === \"ghjxwyz/esp32/max30102/spo2\") { flow.set(\"spo2\", Number(msg.payload)); }\n\n// 2) Les seuils (tu peux les changer)\nconst SEUIL_BPM = 120; // au-dessus = danger\nconst SEUIL_SPO2 = 90; // en dessous = danger\n\n// 3) On recupere les valeurs memorisees\nlet bpm = flow.get(\"bpm\") || 0;\nlet spo2 = flow.get(\"spo2\") || 100;\nlet surveillance = flow.get(\"surveillance\") || false;\n\n// 4) La decision\nlet danger = (bpm > SEUIL_BPM) || (spo2 > 0 && spo2 < SEUIL_SPO2);\nlet alarme = surveillance && danger;\n\n// 5) Texte pour le dashboard\nlet texte;\nif (!surveillance) texte = \"⏸ Surveillance désactivée (appuie sur le bouton)\";\nelse if (alarme) texte = \"🚨 ALARME ! BPM = \" + bpm + \" | SpO2 = \" + spo2 + \" %\";\nelse texte = \"✅ Normal — BPM = \" + bpm + \" | SpO2 = \" + spo2 + \" %\";\n\n// 6) Ordre LED seulement quand l'etat de l'alarme change\n// (pour ne pas ecraser le switch du dashboard a chaque mesure)\nlet ancienne = flow.get(\"alarmeEnCours\") || false;\nflow.set(\"alarmeEnCours\", alarme);\nlet msgLed = null;\nif (alarme !== ancienne) {\n msgLed = { payload: alarme ? \"on\" : \"off\" };\n}\n\n// 7) Etat du bouton toggle pour le dashboard\nlet texteBouton = surveillance ? \"🟢 ON (surveillance activée)\" : \"⚪ OFF (surveillance coupée)\";\n\nreturn [ msgLed, { payload: texte }, { payload: texteBouton } ];\n",
