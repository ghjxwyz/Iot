  {
    "id": "fn_statut",
    "type": "function",
    "z": "tab_sante",
    "name": "Formater le diagnostic",
    "func": "// Entrée : {\"code\":0,\"message\":\"...\",\"rssi\":-60,\"heap\":200000,\"uptime\":120}\n//          {\"code\":-1,...} si le nœud principal a disparu (Last Will)\nconst s = msg.payload || {};\nif (s.code === -1) {\n    return [ { payload: \"🔴 HORS LIGNE (plus de nouvelles du nœud principal)\" }, { payload: \"--\" } ];\n}\nconst icone = (s.code === 0) ? \"🟢\" : \"🟠\";\nconst etat = icone + \" [\" + s.code + \"] \" + s.message;\n\nlet details = \"--\";\nif (s.rssi !== undefined) {\n    const min = Math.floor(s.uptime / 60), sec = s.uptime % 60;\n    details = \"WiFi \" + s.rssi + \" dBm | RAM libre \" + Math.round(s.heap / 1024) +\n              \" ko | allumé depuis \" + min + \" min \" + sec + \" s\";\n}\nreturn [ { payload: etat }, { payload: details } ];",
    "outputs": 2,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 410,
    "y": 1080,
    "wires": [
      [
        "txt_statut"
      ],
      [
        "txt_details"
      ]
    ]
  },
