  {
    "id": "fn_journal",
    "type": "function",
    "z": "tab_sante",
    "name": "Journal des mesures",
    "func": "// Garde les 20 dernières mesures valides pour le tableau,\n// et ajoute chaque mesure au fichier CSV.\nconst m = msg.payload;\nconst maintenant = new Date();\nconst alarme = flow.get(\"alarmeEnCours\") ? \"🚨 OUI\" : \"✅ non\";\n\nconst ligne = {\n    \"Heure\": maintenant.toLocaleTimeString(\"fr-FR\"),\n    \"Pouls (BPM)\": m.bpm,\n    \"SpO2 (%)\": m.spo2,\n    \"Température (°C)\": (m.temp !== null) ? m.temp : \"--\",\n    \"Alarme\": alarme\n};\n\nlet journal = flow.get(\"journal\") || [];\njournal.unshift(ligne);                  // la plus récente en haut\njournal = journal.slice(0, 20);\nflow.set(\"journal\", journal);\n\n// date;bpm;spo2;temperature;alarme (s'ouvre directement dans Excel)\nconst csv = maintenant.toLocaleString(\"fr-FR\") + \";\" + m.bpm + \";\" + m.spo2 + \";\" +\n            ((m.temp !== null) ? String(m.temp).replace(\".\", \",\") : \"\") + \";\" +\n            (flow.get(\"alarmeEnCours\") ? 1 : 0);\n\nreturn [ { payload: journal }, { payload: csv } ];",
    "outputs": 2,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
