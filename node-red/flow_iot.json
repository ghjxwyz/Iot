  {
    "id": "fn_alarme",
    "type": "function",
    "z": "tab_sante",
    "name": "ALARME",
    "func": "// ============================================================\n// FONCTION ALARME\n// Entrées : \"mesure\" (bpm/spo2), \"esp32/button1\", \"recalc\" (seuils), \"init\"\n// Sortie 1 : \"on\"/\"off\" -> esp32/alarme (la LED du pilotage clignote)\n// Sortie 2 : texte de l'état de l'alarme\n// Sortie 3 : texte de l'état de la surveillance (toggle du bouton)\n// Sortie 4 : notification pop-up quand l'alarme se déclenche\n// ============================================================\n\n// 1) Bouton : chaque nouvel appui inverse la surveillance ON/OFF\nif (msg.topic === \"esp32/button1\") {\n    const etat = String(msg.payload);                  // \"down\" = appuyé, \"up\" = relâché\n    const avant = flow.get(\"dernierEtatBouton\") || \"up\";\n    flow.set(\"dernierEtatBouton\", etat);\n    if (etat === \"down\" && avant === \"up\") {\n        flow.set(\"surveillance\", !(flow.get(\"surveillance\") || false));\n    }\n}\n\n// 2) Nouvelle mesure\nif (msg.topic === \"mesure\") {\n    flow.set(\"bpm\", msg.payload.bpm);\n    flow.set(\"spo2\", msg.payload.spo2);\n}\n\n// 3) Seuils (réglables avec les curseurs du dashboard)\nconst SEUIL_BPM  = flow.get(\"seuilBpm\")  || 120;   // au-dessus = danger\nconst SEUIL_SPO2 = flow.get(\"seuilSpo2\") || 90;    // en dessous = danger\n\nconst bpm  = flow.get(\"bpm\");\nconst spo2 = flow.get(\"spo2\");\nconst surveillance = flow.get(\"surveillance\") || false;\nconst aDesMesures = (typeof bpm === \"number\" && typeof spo2 === \"number\");\n\n// 4) La décision\nlet raison = \"\";\nif (aDesMesures && bpm > SEUIL_BPM)   raison = \"pouls trop haut (\" + bpm + \" > \" + SEUIL_BPM + \" BPM)\";\nif (aDesMesures && spo2 < SEUIL_SPO2) raison = \"oxygène trop bas (\" + spo2 + \" < \" + SEUIL_SPO2 + \" %)\";\nconst danger = raison !== \"\";\nconst alarme = surveillance && danger;\n\n// 5) Texte pour le dashboard\nlet texte;\nif (!surveillance)     texte = \"⏸ Surveillance désactivée (appuie sur le bouton)\";\nelse if (!aDesMesures) texte = \"⏳ Surveillance active, en attente de mesures\";\nelse if (alarme)       texte = \"🚨 ALARME : \" + raison;\nelse                   texte = \"✅ Normal (BPM \" + bpm + \" | SpO2 \" + spo2 + \" %)\";\n\nconst texteSurveillance = surveillance ? \"🟢 ON (surveillance activée)\" : \"⚪ OFF (surveillance coupée)\";\n\n// 6) Ordre à la LED seulement quand l'état de l'alarme change\nconst ancienne = flow.get(\"alarmeEnCours\") || false;\nflow.set(\"alarmeEnCours\", alarme);\nconst versLed = (alarme !== ancienne || msg.topic === \"init\") ? { payload: alarme ? \"on\" : \"off\" } : null;\nconst versNotif = (alarme && !ancienne) ? { payload: \"🚨 ALARME : \" + raison } : null;\n\nnode.status({ fill: alarme ? \"red\" : (surveillance ? \"green\" : \"grey\"), shape: \"dot\",\n              text: alarme ? \"ALARME\" : (surveillance ? \"surveillance ON\" : \"surveillance OFF\") });\n\nreturn [ versLed, { payload: texte }, { payload: texteSurveillance }, versNotif ];",
    "outputs": 4,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 1000,
    "y": 640,
    "wires": [
      [
        "out_alarme"
      ],
      [
        "txt_alarme"
      ],
      [
        "txt_surveillance"
      ],
      [
        "notif"
      ]
    ],
    "outputLabels": [
      "LED alarme",
      "texte alarme",
      "surveillance",
      "notification"
    ]
  },
