  {
    "id": "fn_decode",
    "type": "function",
    "z": "tab_sante",
    "name": "Décoder la mesure",
    "func": "// Entrée : {\"bpm\":72,\"spo2\":98,\"temp\":31.5,\"valide\":true}\nconst m = msg.payload || {};\nconst temp = (typeof m.temp === \"number\") ? Math.round(m.temp * 10) / 10 : null;\nconst versTemp = (temp !== null) ? { payload: temp } : null;\n\nif (m.valide !== true) {\n    // Mesure invalide : on n'ajoute rien aux courbes ni à l'alarme\n    return [null, null, versTemp, null, null,\n            { payload: \"⚠️ Pas de mesure : pose le doigt sur le capteur sans bouger\" }];\n}\n\nreturn [\n    { topic: \"BPM\",  payload: m.bpm },                                  // courbe + jauge BPM\n    { topic: \"SpO2\", payload: m.spo2 },                                 // courbe + jauge SpO2\n    versTemp,                                                           // jauge température\n    { topic: \"mesure\", payload: { bpm: m.bpm, spo2: m.spo2 } },         // alarme\n    { payload: { bpm: m.bpm, spo2: m.spo2, temp: temp } },              // journal\n    { payload: \"✅ Mesure valide\" }                                     // qualité du signal\n];",
    "outputs": 6,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 420,
    "y": 120,
    "wires": [
      [
        "gauge_bpm",
        "chart_bpm"
      ],
      [
        "gauge_spo2",
        "chart_spo2"
      ],
      [
        "gauge_temp"
      ],
      [
        "fn_alarme"
      ],
      [
        "fn_journal"
      ],
      [
        "txt_qualite"
      ]
    ],
    "outputLabels": [
      "BPM",
      "SpO2",
      "température",
      "vers alarme",
      "vers journal",
      "qualité"
    ]
  },
